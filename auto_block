import os
import re
import config
import pandas as pd
from datetime import datetime


def is_12_pm(file):
    """
    Process only files generated after 12 PM.
    """
    return datetime.fromtimestamp(os.path.getmtime(file)).hour >= 12


def extract_log_data(file_path):
    """
    Extract Jig No and Result from one log file.

    Expected format:
        Jig No : 191
        Result : FAIL
    """
    try:
        jig_no = None
        result = None
        update_time = datetime.fromtimestamp(os.path.getmtime(file_path))

        with open(file_path, "r", errors="ignore") as f:
            for line in f:
                line = line.strip()

                jig_match = re.search(r"Jig\s*No\s*[:=]\s*(\d+)", line, re.IGNORECASE)
                result_match = re.search(
                    r"Result\s*[:=]\s*(PASS|FAIL)", line, re.IGNORECASE
                )

                if jig_match:
                    jig_no = int(jig_match.group(1))

                if result_match:
                    result = result_match.group(1).upper()

        if jig_no is None or result is None:
            return None

        # Example:
        # 191 -> DL 19, Port 1
        # 196 -> DL 19, Port 6
        dl_no = jig_no // 10
        port_no = jig_no % 10

        return {
            "file": os.path.basename(file_path),
            "jig_no": jig_no,
            "dl_no": dl_no,
            "port_no": port_no,
            "result": result,
            "update_time": update_time
        }

    except Exception as e:
        print(f"Error reading {file_path}: {e}")
        return None


def read_latest_dfile(files):
    """
    Read all files and return DataFrame.
    """
    records = []

    for file in files:
        data = extract_log_data(file)
        if data:
            records.append(data)

    if not records:
        return None

    df = pd.DataFrame(records)
    df = df.sort_values("update_time")
    return df


def read_latest_array_file(file_array):
    """
    Read files for one port.
    """
    if not file_array:
        return None

    file_array = sorted(file_array, key=os.path.getmtime)
    return read_latest_dfile(file_array)


def check_last_3_fail(df):
    """
    Check whether the last 3 results are FAIL.
    """
    if df is None or len(df) < 3:
        return False

    last_3 = df.tail(3)["result"].tolist()
    return last_3 == ["FAIL", "FAIL", "FAIL"]


def block_port(dl_no, port_no):
    """
    Replace this with your GUI automation code.
    """
    print(f"BLOCK PORT -> DL {dl_no}, Port {port_no}")


def processlog(directory):
    """
    Main function:
    1. Read all CSV/log files.
    2. Group by port.
    3. Check last 3 FAILs.
    4. Trigger block.
    """

    # Reset arrays
    config.f_arr = [[] for _ in range(6)]

    files = [
        os.path.join(directory, f)
        for f in os.listdir(directory)
        if f.endswith(".csv") or f.endswith(".log") or f.endswith(".txt")
    ]

    for file in files:
        if not is_12_pm(file):
            continue

        data = extract_log_data(file)
        if not data:
            continue

        port_no = data["port_no"]

        # Ports 1 to 6 only
        if 1 <= port_no <= 6:
            config.f_arr[port_no - 1].append(file)

    # Process each port
    for i in range(6):
        df = read_latest_array_file(config.f_arr[i])

        if df is None:
            continue

        print(f"\n=== Port {i + 1} ===")
        print(df[["jig_no", "dl_no", "port_no", "result"]].tail(5))

        if check_last_3_fail(df):
            dl_no = df.iloc[-1]["dl_no"]
            port_no = df.iloc[-1]["port_no"]

            print(
                f"ALERT: DL {dl_no}, Port {port_no} "
                f"failed 3 consecutive times."
            )

            block_port(dl_no, port_no)

    return config.f_arr