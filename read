Below is a simple Python example using pySerial to communicate with the ITV2050-RC2L over RS-232. It includes functions to:

Set pressure (SET nnn)

Read setpoint (REQ)

Read actual pressure (MON)

Convert counts to MPa

Perform a basic pressure sweep test


Install pySerial

pip install pyserial

ITV2050 Communication Class

import serial
import time


class ITV2050:
    FULL_SCALE_MPA = 0.9

    def __init__(self, port, baudrate=9600, timeout=1):
        self.ser = serial.Serial(
            port=port,
            baudrate=baudrate,
            bytesize=serial.EIGHTBITS,
            parity=serial.PARITY_NONE,
            stopbits=serial.STOPBITS_ONE,
            timeout=timeout
        )

    def send_command(self, cmd):
        command = f"{cmd}\r\n"
        self.ser.write(command.encode())

        response = self.ser.readline().decode().strip()
        return response

    def set_pressure(self, counts):
        counts = max(0, min(1023, counts))
        self.send_command(f"SET {counts}")

    def read_setpoint(self):
        response = self.send_command("REQ")
        return int(response)

    def read_pressure_counts(self):
        response = self.send_command("MON")
        return int(response)

    def read_pressure_mpa(self):
        counts = self.read_pressure_counts()
        return counts / 1023.0 * self.FULL_SCALE_MPA

    def close(self):
        self.ser.close()


