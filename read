Example 4: Simple Closed-Loop Flow Control

Assume:

Flow sensor returns flow in m³/h.

ITV controls pressure.

Desired flow = 500 m³/h.


import time

TARGET_FLOW = 500.0

setpoint = 500

itv = ITV2050("COM3")


def read_flow():
    """
    Replace with your actual flow sensor code.
    """
    return 450.0


try:
    while True:

        flow = read_flow()

        error = TARGET_FLOW - flow

        gain = 0.5

        setpoint += int(gain * error)

        setpoint = max(0, min(1023, setpoint))

        itv.set_pressure(setpoint)

        print(
            f"Flow={flow:.1f} m3/h "
            f"Error={error:.1f} "
            f"SET={setpoint}"
        )

        time.sleep(0.2)

finally:
    itv.close()


